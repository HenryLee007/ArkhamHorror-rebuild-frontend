events {}

http {
  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }
  resolver 127.0.0.11 ipv6=off valid=30s;

  server {
    listen 3000;
    server_name .arkhamhorror.app;
    client_max_body_size 5M;

    location = /build {
      return 302 /build/;
    }

    location = /build-assets {
      return 302 /build-assets/;
    }

    location /build-assets/ {
      alias /opt/arkham/build-assets/;
      types {
        image/avif avif;
        image/jpeg jpg jpeg;
      }
      default_type application/octet-stream;
      add_header Cache-Control "public, max-age=31536000, immutable";
      try_files $uri =404;
    }

    location /build/ {
        set $arkham_build_web http://arkham-build-web:3000;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass $arkham_build_web;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location = /build-api {
      return 302 /build-api/;
    }

    location /build-api/ {
        set $arkham_build_api http://arkham-build-api:8686;
        rewrite ^/build-api/?(.*)$ /$1 break;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass $arkham_build_api;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        add_header P3P 'CP="ALL DSP COR PSAa PSDa OUR NOR ONL UNI COM NAV"';
    }

    location / {
      root /opt/arkham/src/frontend/dist;
      include  /etc/nginx/mime.types;
      try_files $uri $uri/ /index.html;
    }

    location /health {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        add_header P3P 'CP="ALL DSP COR PSAa PSDa OUR NOR ONL UNI COM NAV"';
    }
  }
}
